(defn walk [form]
  (cond
    (immediate? form)
    (let [form (walk (:form form))]
      (cond
        (pair? form)     (walk (application (immediate (:head form)) (:tail form)))
        (coll? form)     (walk (map immediate form))
        (symbolic? form) (cond
                           (env.bound? form) (walk (env.binding form))
                           (ref? form)       (ns.binding form)
                           true              (immediate form))
        true             form))
    (application? form)
    (let [head (walk (:head form))]
      (cond
        (μ? head)        (walk (env.invoke head (walk (:tail form))))
        (external? head) (call head (:tail form))
        true             (emit :error (str head " is not callable."))))
    (coll? form)     (into (empty form) (map walk form)) ; `map*`?
    (μ? form)        (update form :body (comp walk env.cut)) ; discard cable
    (emission? form) (emit.emit! (:env form) (walk (:msgs form)))
    true             form))

;; It's one hell of a mess, but it's the heart of the language in 24 lines!
;;
;; It's a lot more complicated than lisp. Deeply nested branching and all.
;;
;; We can clean it up, if we add namespace level declarations, by breaking it
;; down like the clj version. It strkes me as telling, though that each of eval,
;; apply, and resolve is only ever invoked from one place. Even the places where
;; I cop out above; `call`, `invoke`, `emit.emit!`, &c. are also only called
;; from one location. I just call them as functions so as not to make this
;; completely unreadable.
;;
;; so the whole language core can be trivially inlined. What does that mean?
