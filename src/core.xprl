;; Isn't it crazy that `def` itself isn't built in?
;; But then if the `:env` channel isn't hooked up correctly, you can't define
;; `def` at all, which is a pretty hardcore form of sandboxing...
(emit :env [def ~(μ x ~(emit :env [~(nth* ~x 1) ~~(nth* ~x 2)] :return ~(nth* ~x 1)))]
      :return def)

;; REVIEW: This initial def cannot accept metadata like docstrings, file name,
;; line & col numbers, etc. So we'll need to use it to write a better one
;; eventually.

(def if* ; previously `select`.
  (μ x
     ~(nth* [~(nth* ~x 2) ~(nth* ~x 3)] ~(-* 2 ~(get* {false 0 true 1} ~(nth* ~x 1))))))

(def if
  (μ x
     ~~(if* ~~(nth* ~x 1) ~(nth* ~x 2) ~(nth* ~x 3))))

;; "Wraps a μ or primitive that takes only literal values in a function that
;; evals its arguments."
(def wrap
  (μ f
     ~(μ args
         ~(~f . ~~args))))

(def nth (wrap . nth*))

(def count (wrap . count*))

(def first (wrap . first*))
(def rest (wrap . rest*))

(def + (wrap . +*))
(def - (wrap . -*))
(def * (wrap . **))
(def / (wrap . /*))

(def > (wrap . >*))
(def < (wrap . <*))
(def = (wrap . =*))

(def not (wrap . not*))

(def symbol? (wrap . symbol?*))
(def empty? (wrap . empty?*))
(def map? (wrap . map?*))
(def list? (wrap . list?*))
(def merge (wrap . merge*))

(def str (wrap . str*))

(def mod (wrap . mod*))

(def even? (wrap . (μ x ~(=* 0 ~(mod* ~(nth* ~x 1) 2)))))

;; REVIEW: Is there any point wrapping this?
(def odd? (wrap . (μ x ~(not* ~(even? . x)))))

;;;;; Core

(def defμ
  (μ x
     ~(def ~(nth* ~x 1)
        (μ ~(nth* ~x 1) ~(nth* ~x 2) ~~(nth* ~x 3)))))

(defμ cond body
  (if (<* ~(count* ~body) 2)
    (emit)
    (if ~(nth* ~body 1)
      ~(nth* ~body 2)
      (cond . ~(rest* ~(rest* ~body))))))

(def let1
  (μ x
     ~((μ ~(nth* ~x 1) ~(nth* ~x 3)) . ~(nth* ~x 2))))

(defμ let* x
  (let1 bindings ~(nth* ~x 1)
        ~(let1 body ~(nth* ~x 2)
               ~(if (empty?* ~bindings)
                  body
                  (let1 ~(nth* ~bindings 1) ~(nth* ~bindings 2)
                        ~(let* ~(rest* ~(rest* ~bindings)) ~body))))))

(defμ let-map x
  (let1 bindings ~(nth* ~x 1)
        ~(let1 body ~(nth* ~x 2)
               ~(if* ~(empty?* ~bindings)
                  ~body
                  ~(let1 kv ~(first* ~bindings)
                        ~(let1 ~(nth* ~kv 1) ~(nth* ~kv 2)
                               ~(let-map ~(rest* ~bindings) ~body)))))))

(def destructure-map
  (μ mp
     ~(emit :error "not implemented")))

(defμ destructure xy
  (let* [params ~(nth* ~xy 1)
         args   ~(nth* ~xy 2)]
    ~(cond
       (symbol?* ~params) {params args}
       (empty?* ~params)  {}
       (empty?* ~args)    (emit :error "pattern mismatch")
       (list?* ~params)   (merge
                           (destructure ~(first* ~params) ~(first* ~args))
                           (destructure ~(rest* ~params) ~(rest* ~args)))
       (map?* ~params)    (merge
                           (destructure-map ~(first* ~params) ~(first* ~args))
                           (destructure ~(rest* ~params) ~(rest* ~args)))
       true               (emit :error (str "Cannot destructure: " params ", " args)))))

;; (def fn
;;   (μ x
;;      ~(μ args
;;          ~~((μ ~(nth* ~x 1) ~(nth* ~x 2)) . ~~args))))

(def fn2
  (μ x
     ~(μ args
         ~(let1 bindings ~(destructure ~(nth* ~x 1) ~~args)
                ~(let-map ~bindings
                   ~~(nth* ~x 2))))))

(def fn3
  (μ x
     ~(μ ~(nth* ~x 1) args
         ~(let-map ~(destructure ~(nth* ~x 2) ~~args)
            ~~(nth* ~x 3)))))

(def fn
  (μ args
     ~(cond
        ;; TODO: Docstrings, metadata, etc.
        (= 2 (count args)) (fn2 . ~args)
        (= 3 (count args)) (fn3 . ~args))))

