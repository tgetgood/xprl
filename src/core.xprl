;; Isn't it crazy that `def` itself isn't built in?
;; But then if the `:env` channel isn't hooked up correctly, you can't define
;; `def` at all, which is a pretty hardcore form of sandboxing...
(emit :env [def ~(μ x ~(emit :env [~(nth* ~x 1) ~~(nth* ~x 2)] :return ~(nth* ~x 1)))]
      :return def)

;; REVIEW: This initial def cannot accept metadata like docstrings, file line &
;; col numbers, etc. So we'll need to use it to write a better one eventually.

;; "Wraps a μ or primitive that takes only literal values in a function that
;; evals its arguments."
(def wrap
  (μ f
     ~(μ args
         ~(~f . ~~args))))

(def nth (wrap . nth*))

(def count (wrap . count*))

(def first (wrap . first*))
(def rest (wrap . rest*))

(def + (wrap . +*))
(def - (wrap . -*))
(def * (wrap . **))
(def / (wrap . /*))

(def > (wrap . >*))
(def < (wrap . <*))
(def = (wrap . =*))

(def not (wrap . not*))

(def symbol? (wrap . symbol?*))
(def empty? (wrap . empty?*))
(def map? (wrap . map?*))
(def list? (wrap . list?*))
(def merge (wrap . merge*))

(def str (wrap . str*))

(def seq (wrap . seq*))
(def conc (wrap . conc*))

(def connect (wrap . connect*))


;;;;; Core

(def if
  (μ x
     ~~(select ~~(nth* ~x 1) ~(nth* ~x 2) ~(nth* ~x 3))))

(def defμ
  (μ x
     ~(def ~(nth* ~x 1)
        (μ ~(nth* ~x 1) ~(nth* ~x 2) ~~(nth* ~x 3)))))

(defμ cond body
  (if (< (count body) 2)
    (emit)
    (if (nth body 1)
      (nth body 2)
      (cond . ~(rest (rest body))))))

(defμ condμ body
  ;; gets an extra `~` from `defμ`
  ~(select ~(<* ~(count* ~body) 2)
            (emit)
            ~(select ~~(nth* ~body 1)
                     ~(nth* ~body 2)
                     (condμ . ~(rest* ~(rest* ~body))))))

(def destructure-map
  (μ mp
     ~(emit :error "not implemented")))

(defμ destructure x
  (condμ
   (empty?* ~(nth* ~x 1))  {}
   (symbol?* ~(nth* ~x 1)) {(nth* ~x 1) (nth* ~x 2)}
   (list?* ~(nth* ~x 1))   (merge
                            (destructure ~(first* ~(nth* ~x 1)) ~(first* ~(nth* ~x 2)))
                            (destructure ~(rest* ~(nth* ~x 1)) ~(rest* ~(nth* ~x 2))))
   (map?* ~(nth* ~x 1))   (merge
                            (destructure-map ~(first* ~(nth* ~x 1)) ~(first* ~(nth* ~x 2)))
                            (destructure ~(rest* ~(nth* ~x 1)) ~(rest* ~(nth* ~x 2))))
   true                   (emit :error ~(str* "Cannot destructure: " ~x))))

#_(def destructure
  (μ destructure xy
     ~(cond
        ~(empty? (nth xy 1))  {}
        ~(symbol? (nth xy 1)) ~{(nth xy 1) (nth xy 2)}

        ~(list? (nth xy 1)) ~(merge
                              (destructure ~(first (nth xy 1)) ~(first (nth xy 2)))
                              (destructure ~(rest (nth xy 1)) ~(rest (nth xy 2))))
        ~(map? (nth xy 1))  ~(merge
                              (destructure-map ~(first (nth xy 1)) ~(first (nth xy 2)))
                              (destructure ~(rest (nth xy 1)) ~(rest (nth xy 2))))
        true                ~(emit :error (str "Cannot destructure " xy)))))

