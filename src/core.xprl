;; Isn't it crazy that `def` itself isn't built in?
;; But then if the `:env` channel isn't hooked up correctly, you can't define
;; `def` at all, which is a pretty hardcore form of sandboxing...
(emit :env [def ~(μ x ~(emit :env [~(nth* ~x 1) ~~(nth* ~x 2)] :return ~(nth* ~x 1)))]
      :return def)

;; REVIEW: This initial def cannot accept metadata like docstrings, file line &
;; col numbers, etc. So we'll need to use it to write a better one eventually.

;; "Wraps a μ or primitive that takes only literal values in a function that
;; evals its arguments."
(def wrap
  (μ f
     ~(μ args
         ~(~f . ~~args))))

(def nth (wrap . nth*))

(def count (wrap . count*))

(def first (wrap . first*))
(def rest (wrap . rest*))

(def + (wrap . +*))
(def - (wrap . -*))
(def * (wrap . **))
(def / (wrap . /*))

(def > (wrap . >*))
(def < (wrap . <*))
(def = (wrap . =*))

(def not (wrap . not*))

(def symbol? (wrap . symbol?*))
(def empty? (wrap . empty?*))
(def map? (wrap . map?*))
(def list? (wrap . list?*))
(def merge (wrap . merge*))

(def str (wrap . str*))

(def seq (wrap . seq*))
(def conc (wrap . conc*))

(def connect (wrap . connect*))


;;;;; Core

(def defμ
  (μ x
     ~(def ~(nth* ~x 1)
        (μ ~(nth* ~x 1) ~(nth* ~x 2) ~~(nth* ~x 3)))))

(defμ cond body
  (select ~(<* ~(count* ~body) 2)
          ~(emit)
          ~(select ~~(nth* ~body 1)
                   ~~(nth* ~body 2)
                   ~(cond . ~(rest* ~(rest* ~body))))))

(def if
  (μ x
     ~~(select ~~(nth* ~x 1) ~(nth* ~x 2) ~(nth* ~x 3))))

(def let1
  ;; μ friendly let suitable for syntax substitutions
  (μ x
     ~((μ ~(nth* ~x 1) ~(nth* ~x 3)) . ~(nth* ~x 2))))

(def alet1
  ;; Applicative let that does what you expect.
  (μ x
     ~~((μ ~(nth* ~x 1) ~(nth* ~x 3)) . ~~(nth* ~x 2))))

(defμ let* x
  (let1 bindings ~(nth* ~x 1)
        ~(let1 body ~(nth* ~x 2)
              ~(select ~(empty?* ~bindings)
                       ~body
                       ~(let1 ~(nth* ~bindings 1) ~(nth* ~bindings 2)
                              ~(let* ~(rest* ~(rest* ~bindings)) ~body))))))

(defμ let-map x
  (let1 bindings ~(nth* ~x 1)
        ~(let1 body ~(nth* ~x 2)
               ~(select ~(empty?* ~bindings)
                        ~body
                        ~(let1 kv ~(first* ~bindings)
                               ~(let1 ~(nth* ~kv 1) ~(nth* ~kv 2)
                                      ~(let-map ~(rest* ~bindings) ~body)))))))

(def destructure-map
  (μ mp
     ~(emit :error "not implemented")))

(defμ destructure xy
  (let* [params ~(nth* ~xy 1)
         args   ~(nth* ~xy 2)]
    ~(cond
       (symbol?* ~params) {params args}
       (empty?* ~params)  {}
       (empty?* ~args)    (emit :error "pattern mismatch")
       (list?* ~params)   (merge
                           (destructure ~(first* ~params) ~(first* ~args))
                           (destructure ~(rest* ~params) ~(rest* ~args)))
       (map?* ~params)    (merge
                           (destructure-map ~(first* ~params) ~(first* ~args))
                           (destructure ~(rest* ~params) ~(rest* ~args)))
       true               (emit :error (str "Cannot destructure: " params ", " args)))))

(def fn2
  (μ x
     ~(μ args
         ~(let-map ~(destructure ~(nth* ~x 1) ~~args)
            ~~(nth* ~x 2)))))

(def fn3
  (μ x
     ~(μ ~(nth* ~x 1) args
         ~(let-map ~(destructure ~(nth* ~x 2) ~~args)
            ~~(nth* ~x 3)))))

