;; (defmulti fn [name params body]
;;   )

;; This fn is not named and thus cannot call itself recursively.
#_(def fn
  )

;;(μ x ~(wrap . ~(μ  ~(nth x 1) ~~(nth x 2)))))

;; This one is named. Note it's the outer μ that bears the name.
(def fn*
  (μ x
     ~(μ ~(nth* ~x 1) args
         ~((μ ~(nth* ~x 2) ~~(nth* ~x 3)) . ~~args))))

(def defn
  (μ x
     ~(def ~(nth* ~x 1) (fn* . ~x))))

(defμ when x
  (if ~(nth* ~x 1) ~(nth* ~x 2) (emit)))

(defn inc x (+ 1 (nth x 1)))

(def !1
  (μ !1 n
     ~~(select ~(<* ~n 2)
              1
              (** ~n ~(!1 . ~(-* ~n 1))))))

(defμ !2 n
  ~~(select ~(=* ~n 0)
              1
              (** ~n ~(!2 . ~(-* ~n 1)))))

(defμ !3 n
  (if (< n 2)
    1
    (* n (!3 . ~(- n 1)))))

(defμ !4 n
  (if (= n 0)
    1
    (* n (!4 . ~(- n 1)))))

(defn !5 n
  (if (= n 0)
    1
    (* n (!5 . (- n 1)))))

(defn !6 n
  (if (< n 2)
    1
    (* n (!6 . (- n 1)))))
