;;;;; tests


#_(defμ pow x
  (let* [n ~(nth* ~x 1)
         k ~(nth* ~x 2)]
     ~(cond
        (=* 0 ~k)  1
        (=* 1 ~k)  n
        (even? ~k) (pow ~(** ~n ~n) ~(/* ~k 2))
        (odd? ~k)  (** ~n ~(pow ~n ~(-* ~k 1))))))

