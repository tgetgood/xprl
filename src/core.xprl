;; (defmulti fn [name params body]
;;   )


(def defn
  (μ x
     ~(def ~(nth* ~x 1) (fn . ~x))))

(defμ when x
  (if ~(nth* ~x 1) ~(nth* ~x 2) (emit)))

(defn inc [x]
  (+ 1 x))

(def !1
  (μ !1 n
     ~(if ~(<* ~n 2)
        1
        (** ~n ~(!1 . ~(-* ~n 1))))))

(defμ !2 n
  ~(if ~(=* ~n 0)
           1
           (** ~n ~(!2 . ~(-* ~n 1)))))

(defμ !3 n
  (if (< n 2)
    1
    (* n (!3 . ~(- n 1)))))

(defμ !4 n
  (if (= n 0)
    1
    (* n (!4 . ~(- n 1)))))

(defn !5 [n]
  (if (= n 0)
    1
    (* n (!5 (- n 1)))))

(defn !6 [n]
  (if (< n 2)
    1
    (* n (!6 (- n 1)))))

(def !7
  (fn !7 [n]
    (if (< n 2)
      1
      (* n (!7 (- n 1))))))
