(def nth (wrap . nth*))

(def count (wrap . count*))

(def - (wrap . -*))
(def * (wrap . **))
(def / (wrap . /*))

(def > (wrap . >*))
(def < (wrap . <*))
(def = (wrap . =*))


(def symbol? (wrap . symbol?*))
(def map? (wrap . map?*))
(def list? (wrap . list?*))

(def str (wrap . str*))

(def mod (wrap . mod*))

(def even? (wrap . (μ x ~(=* 0 ~(mod* ~(nth* ~x 1) 2)))))

;; REVIEW: Is there any point wrapping this?
(def odd? (wrap . (μ x ~(not* ~(even? . x)))))

;;;;; tests


#_(defμ pow x
  (let* [n ~(nth* ~x 1)
         k ~(nth* ~x 2)]
     ~(cond
        (=* 0 ~k)  1
        (=* 1 ~k)  n
        (even? ~k) (pow ~(** ~n ~n) ~(/* ~k 2))
        (odd? ~k)  (** ~n ~(pow ~n ~(-* ~k 1))))))

