;; The code that follows assumes the existence of two system capabilities
;; provided by channels.
;; The first (:env) allows us to name a value and refer to that value later by
;; name. Such names are write once, read forever.
;; The second (:schedule) schedules a computation to be performed. The
;; computation must fully bind its own IO since nothing can be passed to or from
;; it once it has been scheduled.
;;
;; From these two system primitives, I'm going to try to bootstrap an interpreter.

(emit :env [def ~(μ x ~(emit :env [~(nth* ~x 1) ~~(nth* ~x 2)] :return ~(nth* ~x 1)))]
      :return def)

;; "Wraps a μ or primitive that takes only literal values in a function that
;; evals its arguments."
(def wrap
  (μ f
     ~(μ args
         ~(~f . ~~args))))

(def first (wrap . first*))
(def rest (wrap . rest*))
(def empty? (wrap . empty?*))
(def merge (wrap . merge*))

(def let1
  (μ x
     ~((μ ~(nth* ~x 1) ~(nth* ~x 3)) . ~(nth* ~x 2))))

;;;;; branching

(def if* ; previously `select`.
  (μ x
     ~(nth* [~(nth* ~x 2) ~(nth* ~x 3)] ~(-* 2 ~(get* {false 0 true 1} ~(nth* ~x 1))))))

(def if
  (μ x
     ~~(if* ~~(nth* ~x 1) ~(nth* ~x 2) ~(nth* ~x 3))))

(def boolfn
  (μ x
     ~(get* {true ~(μ x ~~(nth* ~x 1)) false ~(μ x ~~(nth* ~x 2))} ~x)))

;; smalltalk (or lambda calculus) style `if`.
;; nothing like two impls of `if` to test against each other!
(def sif
  (μ x
     ~((boolfn . ~~(nth* ~x 1)) ~(nth* ~x 2) ~(nth* ~x 3))))

(def when
  (μ x
     ~(if ~(nth* ~x 1) ~(nth* ~x 2) (emit))))

