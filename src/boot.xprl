;; The code that follows assumes the existence of two system capabilities
;; provided by channels.
;; The first (:env) allows us to name a value and refer to that value later by
;; name. Such names are write once, read forever.
;; The second (:schedule) schedules a computation to be performed. The
;; computation must fully bind its own IO since nothing can be passed to or from
;; it once it has been scheduled.
;;
;; From these two system primitives, I'm going to try to bootstrap an interpreter.

(emit [:env [def ~(μ x ~(emit [:env [~(nth* ~x 1) ~~(nth* ~x 2)]]
                              [:return ~(nth* ~x 1)]))]]
      [:return def])

;; Test ns clobbering
;; (def x 42)

;; "Wraps a μ or primitive that takes only literal values in a function that
;; evals its arguments."
(def wrap
  (μ f
     ~(μ args
         ~(~f . ~~args))))

(def first (wrap . first*))
(def rest (wrap . rest*))
(def empty? (wrap . empty?*))
(def merge (wrap . merge*))

;;;;; branching

(def if* ; previously `select`.
  (μ x
     ~(nth* [~(nth* ~x 2) ~(nth* ~x 3)] ~(-* 2 ~(get* {false 0 true 1} ~(nth* ~x 1))))))

(def if
  (μ x
     ~~(if* ~~(nth* ~x 1) ~(nth* ~x 2) ~(nth* ~x 3))))

(def boolfn
  (μ x
     ~(get* {true ~(μ x ~~(nth* ~x 1)) false ~(μ x ~~(nth* ~x 2))} ~x)))

;; smalltalk (or lambda calculus) style `if`.
;; nothing like two impls of `if` to test against each other!
(def sif
  (μ x
     ~((boolfn . ~~(nth* ~x 1)) ~(nth* ~x 2) ~(nth* ~x 3))))

(def when
  (μ x
     ~(if ~(nth* ~x 1) ~(nth* ~x 2) (emit))))

;;;;; Simple recursion

(def let1
  (μ x
     ~((μ ~(nth* ~x 1) ~(nth* ~x 3)) . ~(nth* ~x 2))))

(def defμ*
  (μ x
     ~(def ~(nth* ~x 1)
        (μ ~(nth* ~x 1) ~(nth* ~x 2) ~~(nth* ~x 3)))))

;; (defμ ! x
;;   (if (<* ~(nth* ~x 1) 2)
;;      1
;;      (** ~(nth* ~x 1) ~(! ~(-* ~(nth* ~x 1) 1)))))

(defμ* cond body
  (when (<* 1 ~(count* ~body))
    (if ~(nth* ~body 1)
      ~(nth* ~body 2)
      (cond . ~(rest* ~(rest* ~body))))))

;;;;; destructuring

(defμ* let* x
  (let1 bindings ~(nth* ~x 1)
         ~(let1 body ~(nth* ~x 2)
                ~(if (empty?* ~bindings)
                   body
                   (let1 ~(nth* ~bindings 1) ~(nth* ~bindings 2)
                         ~(let* ~(rest* ~(rest* ~bindings)) ~body))))))

(defμ* let-map x
  (let1 bindings ~(nth* ~x 1)
        ~(let1 body ~(nth* ~x 2)
               ~(if (empty?* ~bindings)
                  body
                  (let1 kv ~(first* ~bindings)
                        ~(let1 ~(nth* ~kv 1) ~(nth* ~kv 2)
                               ~(let-map ~(rest* ~bindings) ~body)))))))

(def destructure-map
  (μ mp
     ~(emit :error "not implemented")))

(defμ* destructure xy
  (let* [params ~(nth* ~xy 1)
          args  ~(nth* ~xy 2)]
     ~(cond
        (symbol?* ~params) {params args}
        (empty?* ~params)  {}
        (empty?* ~args)    (emit :error "pattern mismatch")

        (dot?* ~(first* ~params))
        (destructure ~(first* ~(rest* ~params)) ~args)

        (list?* ~params)
        (merge
         (destructure ~(first* ~params) ~(first* ~args))
         (destructure ~(rest* ~params) ~(rest* ~args)))

        (map?* ~params) (merge
                         (destructure-map ~(first* ~params) ~(first* ~args))
                         (destructure ~(rest* ~params) ~(rest* ~args)))

        true (emit :error ~(str* "Cannot destructure: " ~params ", " ~args)))))

;;;;; definitions

(defμ* fn x
  (if (=* 3 ~(count* ~x))
    (μ ~(nth* ~x 1) args
       ~(let-map ~(destructure ~(nth* ~x 2) ~~args)
          ~~(nth* ~x 3)))
    (μ args
       ~(let-map ~(destructure ~(nth* ~x 1) ~~args)
          ~~(nth* ~x 2)))))

;;; This would make life a lot nicer...

(defμ* defμ x
  (def ~(nth* ~x 1)
     (μ args
        ~(let-map ~(destructure ~(nth* ~x 2) ~args)
           ~~(nth* ~x 3)))))

(defμ fn2 [params body]
  (μ args
     ~(let-map ~(destructure ~params ~args)
        ~~body)))


#_(defμ fn3 [name params body])

;; (defμ fn args
;;   (let1 indirect ~(nth* [error fn2 fn3] ~(count* ~args))
;;         ~(~indirect . ~args)))

#_(def fn
  (μ args
     (let1 named? ~(symbol?* ~(first* ~args))
           ~(let1 methods ~(if named? (rest* ~args) ~args)
                  ~(let1 defs (if (map?* ~(first* ~methods))
                                (nth* ~methods 1)
                                {(nth* ~methods 1) (nth* ~methods 2)})
                         ~(μ ~(when named? (first* ~args)) fn-args
                             ~(let1 dispatch ~(match ~defs ~fn-args)
                                    ~(dispatch . ~fn-args))))))))

(def defn
  (μ x
     ~(def ~(nth* ~x 1) (fn . ~x))))

(def + (wrap . +*))

(defn inc [x]
  (+ x 1))

