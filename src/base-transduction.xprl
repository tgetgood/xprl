;; Low level rewrite of transduction.xprl focusing less on ideal syntax and more
;; on how it will actually work in a pre bootstrapped setting.

;; REVIEW: Curiously, ν seems to be a fully applicative construct despite the
;; fact that it operates symbolically on input streams and continuation maps.
;;
;; I'm very keen to see how this pans out. There might be something very deep
;; here.

(defn map fparams
  (μ params
     ~(ν ccs
         (when (not (empty? (nth params 1)))
           (seq
            (connect ((nth fparams 1) (first (nth params 1))) ccs)
            (connect ((map . fparams) ~(rest (nth params 1))) ccs))))))

;; REVIEW: How does the return channel "close" in this case?
;; i.e. how does `seq` know when to move on from one computation to the next?
;;
;; and how does it "move on"?
;;
;; What does it mean for `(f x)` to "complete"? Do we just wait on emission? or
;; do we need to wait on delivery? Is there even a coherent notion of delivery
;; in the current impl?

;; REVIEW: Here's another odd one:
;; A ν is defined with two formal paramters; inputs and ccs, but in the surface
;; syntax of the langauge they can only ever be called with inputs since ccs
;; doesn't exist until runtime.
;;
;; Thus a ν can call connect freely, "passing" ccs around, but those connections
;; can't actually be made until it itself is connected.
;;
;; So we need to walk the "bodies" of the connect calls (which come first) and
;; return some sort of AST node that *can* be manipulated until it bubbles up to
;; a connection attempt.
;;
;; Should we rely on the fact that `ccs` won't resolve until after connection?
;; What happens if one of the processes doesn't depend on external ccs?
;;
;; Are `seq` & `conc` then just ast nodes which handle connection attempts
;; differently? That sounds too good to be true...

(defn comp [f g]
  ;; This version of `comp` assumes `f` & `g` are both νs.
  (ν params ccs
     (let [inner (chan)]
       (conc
        (connect (f (nth params 1)) (assoc ccs :return inner))
        (connect (g inner) ccs))))) ; ccs points to original return location.

;; TODO: Ensure that ((comp (map f) (map g)) xs) == ((map g) ((map f) xs))

(defn filter [p]
  (map (fn [x] (when (p x) x))))

(defn accumulate [rf init]
  (ν x ccs
     (let [state (last-chan init)]
       (seq
        ;; REVIEW: The mechanics of `last-chan` are very delicate. Don't lose
        ;; sight of that.
        (connect ((map (fn [[state x]] (emit :state (rf state x))))
                  (combine state (nth x 1)))
                 (assoc ccs :state state))
        ;; `(first state)` is just a value and hits `send-return!` within
        ;; connect thus "returning normally". If anything goes wrong it will be
        ;; within the preceeding connection.
        ;;
        ;; REVIEW: `(first state)` must delay until this connection is made.
        ;; That means that reading from a stream must produce an ast node that
        ;; delays until connection time.
        ;;
        ;; Since any stream may park on reading, I guess this is true in
        ;; general. But if a stream has cached elements, then `first` ought to
        ;; be able to just go ahead and return a value (syntactically). In this
        ;; context that's not super useful, but deeper in a form it could lead
        ;; to much better code generation.
        (connect (first state) ccs)))))

;; `accumulate`, when passed a stream(-like), returns a value, not a stream.
;;
;; This is a departure from earlier conceptions where νs returned the :return
;; stream. Instead, νs return nothing and their internal connections do all of
;; the actual communication. This is much cleaner.
;;
;; The return stream can still be accessed from within a ν since `ccs` is a
;; value. I'm no longer sure if that's useful, or just excess power...

(defn into [to from]
  ((accumulate conj to) from))

(defn into [to xf from]
  ((accumulate conj to) (xf from)))

(defn partition [n]
  (ν xs ccs
     (let [state (last-ch [])]
       (seq
        ;; Emit partitioned elements as you go.
        (connect ((map (fn [[state x]]
                         (let [s' (conj state x)]
                           (if (= n (count s'))
                             (emit :return s' :state [])
                             (emit :state s')))))
                  (combine state (nth xs 1)))
                 (assoc ccs :state state))
        ;; Flush the state, if any, once `xs` is exhausted.
        (connect (let [s (first state)]
                   (when (not (empty? s)) s))
                 ccs)))))
