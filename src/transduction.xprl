;; REVIEW: This is only needed in `map` at present, so is there any point
;; keeping it around as a macro?
(def return-stream
  (μ [form]
     ~(let* [[st ch] ~(pipe)]
        ~(net
          ~(with-channels {:return ch} ~form)
          st))))

(defn map-stream [f xs]
  (emit-recur (f (first xs)) f (rest xs)))
;; `emit-recur` is a new old primitive. It is largely designed to implement
;; `map`, but it's more general. It allows a μ to control the order of its
;; emissions with respect to an input stream.

(defn map-stream [f xs ys]
  (emit-recur (f (first xs) (first ys)) f (rest xs) (rest ys)))

(defn map-reduce* [f init xs]
  (if (empty? xs)
    init
    (map-reduce* f (conj init (f (first xs))) (rest xs))))

(defn map-stream [f xs ys . zs]
  (emit-recur (f (first xs) (first ys) . (map-reduce* first [] zs))
               f (rest xs) (rest ys) . (map-reduce* rest [] zs)))

(defn map [f . xs]
  (let [[st ch] (pipe)]
    (net
     ;; Redirect multiple return values into a stream and return that.
     (with-channels {:return ch} (map-stream f . xs))
     st)))

(defn filter [p xs]
  (map (fn [x] (when (p x) x)) xs))

(defn last [xs]
  (let [next (rest xs)]
    (if (empty? next) ; curiously, this is where we have to park and wait.
      (first xs)
      (last next))))

(defn reduce [rf init xs]
  (let [[state state-ch] (pipe init)]
    (net
     (with-channels {:return state-ch}
       (map-stream rf state xs))
     (last state))))
;; So that instead of needing to emit explicitly, we just redirect return values
;; within one subcomputation of the network?

;; TODO: Ensure that (map f (map g xs)) == (map (comp f g) xs)

;; TODO: Think about currying, or at least defining (map f) without xs.
;; Ensure that ((comp (map f) (map g)) xs) == ((map g) ((map f) xs))

(defn into [to from]
  (reduce conj to from))

(defn partition [n xs]
  (let [[state state-ch] (pipe [])]
    (net
     ;; Emit partitioned elements as you go.
     (map (fn [state x]
            (let [s' (conj state x)]
              (if (= n (count s'))
                (emit :return s' state-ch [])
                (emit state-ch s'))))
          state xs)
     ;; Flush the remaining state, if any, once `xs` is exhausted.
     (let [rem (last state)]
       (when (not (empty? rem))
         rem)))))

(defn scan [f init xs]
  (let [[state state-ch] (pipe init)]
    (map (fn [state x]
           (let [next (f state x)]
             (emit state-ch next :return next)))
         state xs)))

;; This is simpler than the above `into` using `reduce`, but discards n
;; return values which is wasteful. Can we make the cost small enough to
;; disregard when we know the messages will never be read? Can we make it zero
;; cost? We could by hand...
;;
;; REVIEW: Is it really simpler? It just does the same things in different
;; places with more work. Useful as an example perhaps.
(defn into2 [to from]
  (last (scan conj to from)))
