;; Before this file can be read in I need:
;;
;; 1) overloading by destructuring expressions.
;;
;; 2) an implementation of `pipe`.

(def return-stream
  (μ [form]
     ~(let* [[st ch] ~(pipe)]
        ~(net
          ~(with-channels {:return ch} ~form)
          st))))

(defn map* [f xs]
  (emit :return (f (first xs))
        :return (map* f (rest xs))))

(defn map [f xs] (return-stream (map* f xs)))

(defn map* [f xs . yss]
  (emit  :return (f (first xs)  . (map first yss))
         :return (map* f (rest xs)  . (map rest yss))))

(defn map [f xs . yss] (return-stream (map* f xs . yss)))

;; TODO: Ensure that (map f (map g xs)) == (map (comp f g) xs)

;; TODO: Think about currying, or at least defining (map f) without xs.
;; Ensure that ((comp (map f) (map g)) xs) == ((map g) ((map f) xs))

(defn filter [p xs]
  (map (fn [x] (when (p x) x)) xs))

;; Ideally we would have some sort of interrupt on channel close at which point
;; we could get the final element without iteration. But how would that work
;; exectly?
;;
;; A special builtin to track the last value sent on ch could be justified.
;;
;; Unless, of course, we can find some trick to compile this (very common)
;; pattern of (net (populate ch) (last st)) into something that just keeps the
;; most recent value in a register and eventually returns that on a signal.
;;
;; Wouldn't that be swell?

(defn last [xs]
  (let [next (rest xs)]
    (if (empty? next) ; curiously, this is where we have to park and wait.
      (first xs)
      (last next))))

(defn reduce [rf init xs]
  (let [[state state-ch] (pipe init)]
    (net
     (with-channels {:return state-ch}
       (map* rf state xs))
     (last state))))

;; This one doesn't really work since it would require `emit` to send some
;; messages before receiving all of the messages to send.
(defn reduce [rf init xs]
  (let [[st ch] (pipe init)]
    (net
     (emit-all ch (map rf st xs))
     (last st))))

;;;;; And scan. Not sure I have a use for this, but hey.

(defn scan [f init xs]
  (let [[state state-ch] (pipe init)]
    (map (fn [state x]
           (let [next (f state x)]
             (emit state-ch next :return next)))
         state xs)))

;; or (better because we only need one stream instead of two):

(defn scan [rf init xs]
  (let [[st ch] (pipe init)]
    (net
     (emit-all ch (map rf st xs))
     st)))

;; Which gives us the alternate `reduce`:

(defn reduce [rf init xs]
  (last (scan rf init xs)))

;;;;; Moving on

(defn into [to from]
  (reduce conj to from))

(defn partition [n xs]
  (return-stream
   (let [[state state-ch] (pipe [])]
     (net
      ;; Emit partitioned elements as you go.
      (map (fn [state x]
              (let [s' (conj state x)]
                (if (= n (count s'))
                  (emit :return s' state-ch [])
                  (emit state-ch s'))))
            state xs)
      ;; Flush the remaining state, if any, once `xs` is exhausted.
      (let [rem (last state)]
        (when (not (empty? rem))
          rem))))))

(defn repeat [x]
  (emit :return x :return (repeat x)))

(defn interleave [s1 s2]
  (emit :return (first s1)
        :return (first s2)
        :return (interleave (rest s1) (rest s2))))

;; REVIEW: I probably ought to make this idea of emit-all a built in part of the
;; syntax, it comes up so often and we don't want to be forced to create
;; sequences we don't want.
;;
;; maybe something like
;;
;; (emit :log "message" ^:many ch xs)
;;
(def emit-all
  (μ x
     ~(emit . ~(interleave (repeat (first x)) (nth* ~x 2)))))

(def net
  (μ conts
     ~(emit-all :schedule ~conts)))

;;;;; And if you really want it:

(defμ stream xss
  (return-stream ~(emit-all :return xss)))
