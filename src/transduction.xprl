(defn map [f xs]
  ;; REVIEW: is this `not-empty?` necessary? If xs is empty, `(first xs)` will
  ;; unwind without returning, and then so will the seq, and the whole function.
  ;; I think that's a proof we don't need the `when`, no?
  (when (not-empty? xs)
    (seq
     (f (first xs))
     (map f (rest xs)))))

(defn filter [p xs]
  (map (fn [x] (when (p x) x)) xs))

(defn accumulate [rf init xs]
  (let [[state state-ch] (last-chan init)]
    (seq
     ;; REVIEW: The mechanics of this are very delicate:
     ;;
     ;; `last-chan` means that `(first state)` will always return the last
     ;; message received by the `state` channel.
     ;;
     ;; That, in turn, means that we need to ensure that the emission in the
     ;; following is always received before map moves on. I've proved that for
     ;; previous versions but this might not be the same.
     ;;
     ;; We must also ensure that `combine` only reads state ~after~ somebody
     ;; reads the combined channel, otherwise we'll have stale state.
     (with-channels {:state state-ch}
       (map (fn [[state x]] (emit :state (rf state x))) (combine state xs)))
     (first state))))

;; TODO: Ensure that (map f (map g xs)) == (map (comp f g) xs)

;; TODO: Think about currying, or at least defining (map f) without xs.
;; Ensure that ((comp (map f) (map g)) xs) == ((map g) ((map f) xs))

;; REVIEW: The fact that composition is right-to-left with 3 args, but
;; left-to-right with 2 args is very confusing. I like left-to-right semantics
;; to think about pipelines sequentially. Really this is the same as the `->>`
;; macro, but does that make it better?

(defn into [to from]
  ((accumulate conj to) from))

(defn into [to xf from]
  ((accumulate conj to) (xf from)))

(defn partition [n xs]
  (let [[state state-ch] (last-chan)]
    (seq
     ;; Emit partitioned elements as you go.
     (with-channels {:state state-ch}
       (map (fn [[state x]]
              (let [s' (conj state x)]
                (if (= n (count s'))
                  (emit :return s' :state [])
                  (emit :state s'))))
            (combine state xs)))
     ;; Flush the remaining state, if any, once `xs` is exhausted.
     (let [rem (first state)]
       (when (not (empty? rem))
         rem)))))

(defn scan [f init xs]
  (let [[state state-ch] (last-chan init)]
    (with-channels {:state state-ch}
      (map (fn [[state x]]
             (let [next (f state x)]
               (emit :state next :return next)))
           (combine state xs)))))

;; This is simpler than the above `into` using `accumulate`, but discards n
;; return values which might wasteful. Can we make the cost small enough to
;; disregard when we know the messages will never be read? Can we make it zero
;; cost? We could by hand...
(defn into2 [to from]
  (last (scan conj to from)))
