;;;;; Stuff that doesn't belong in the bootstrap code.

(defn inc [x]
  (+ 1 x))

(defn ! [n]
  (if (< n 2)
    1
    (* n (! (- n 1)))))

;;;;; Stuff that doesn't belong anywhere:

;; Exercises from old books to exercise the language. Wouldn't it be nice if
;; very simple programs produced very simple (and thus fast) machine code?
;; That's another problem that needs some attention.

;; How to reverse a stream without buffering it into a vector?
(defn reverse [xs]
  (emit . ~(conj (capture (reverse (rest xs))) [:return (first xs)])))
;; will that be efficient? I doubt it... you're just using the event loop to
;; buffer all the messages for you now. They have to be buffered somewhere,
;; don't they?

(defn min [xs]
  (reduce (fn [s x] (when (< x s) x)) (first xs) (rest xs)))

(defn minmax [xs]
  (let [x (first xs)]
    (reduce (fn [s x]
              (cond
                (< x (:min s)) (assoc s :min x)
                (< s (:max x)) (assoc s :max x)
                true           s))
            {:min x :max x}
            (rest xs))))

;; This is worst case 2N. Can we get Knuth's 3N/2 without realising the whole
;; stream into memory? What about:

(defn minmax2 [xs]
  (let [x (first xs)]
    (reduce (fn [s [x y]]
              (let [[minv maxv] (if (< x y) [x y] [y x])]
                (-> s (update :min min minv) (update :max max maxv))))
            {:min x :max x}
            ;; We need a version of partition that fills the last pair if the
            ;; stream count is odd. In this case duplicating the last value
            ;; would be correct.
            (partition 2 (rest xs)))))
;; This makes 3N/2 ~comparisons~, but it does a lot of other work that might
;; very well swamp the gains.

;; you can't really stream a sort: how can you know the smallest element until
;; you've seen them all? but you can scan and return a sequence of sorted
;; subsequences. Is that useful? maybe.
(defn merge-sorted [xs ys]
  (if (empty? xs)
    (emit-all :return ys)
    (if (empty? ys)
      (emit-all :return xs)
      (let [x (first xs)
            y (first ys)]
        (if (< x y)
          (emit-recur x (rest xs) ys)
          (emit-recur y xs (rest ys)))))))

;; Those `empty?` checks on each iteration are ugly. There should be an event
;; when a stream finishes... and how would that work?

;; So far `capture` has filled this need pretty well, but it requires buffering
;; all output which isn't acceptable in this case.

;; Assume we're using a sorted binary tree as a set
;; This doesn't make a lot of sense as a stream problem.
(defn set-insert [node val]
  (if (empty? node)
    {:type :leaf :value val}
    ;; Assume we've already checked and we know the value is not in the tree
    (set-insert (get node (if (< val (:value node)) :left :right)) val)))
;; That gives us one branch (which should be replaced by polymorphic dispatch)
;; and one data selection.
;; It's a little more obscure than necessary, but still pretty clear I think.

(defn insert-sorted [v x]

  )

(defn insertion-sort [xs]
  (reduce insert-sorted [] xs))

(defn leaves [node]
  (if (leaf? node)
    node
    ;; preserve order of leaves
    (emit-recur (leaves (:left node)) leaves (:right node))))

;; run `rf` only on leaves of the tree, ignoring interior nodes.
(defn reduce-leaves [rf init tree]
  (reduce rf init (return-stream (leaves tree))))

;; Multiply two matricies of ints. The ints can be of arbitrary but fixed width.
;; The matricies are square but of arbitrary size.
(defn matmul [xs ys]
  ;; transposing the second operand not only makes the code clearer, it also
  ;; ought to improve cache performance enormously.
  (let [ys' (transpose ys)]
    ;; map should be able to handle simd itself since that's where it will
    ;; almost always happen. Of course it depends on the operator.
    ;; We could even use fma here if reduce and map can be aware of each other.
    ;; That might be a bit much to ask.
    ;;
    ;; Honestly it's probably easier to do those optimisations on the bytecode.
    (into [] (map (fn [x]
                    (into [] (map (fn [y]
                                    (reduce + (map * x y)))
                                  ys')))
                 xs))))
