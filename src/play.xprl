;; Exercises from old books to exercise the language. Wouldn't it be nice if
;; very simple programs produced very simple (and thus fast) machine code?
;; That's another problem that needs some attention.

;; How to reverse a stream without buffering it into a vector?
(defn reverse [xs]
  (emit (conj (capture (reverse (rest xs))) [:return (first xs)])))
;; will that be efficient? I doubt it... you're just using the event loop to
;; buffer all the messages for you now. They have to be buffered somewhere,
;; don't they?

(defn min [xs]
  (let [[st ch] (first xs)]
    (net
     (last st) ; TODO: This pattern comes up so often it ought to have a name.
     (map (fn [s x] (when (< x s) (emit ch x))) st (rest xs)))))

(defn minmax [xs]
  (let [x       (first xs)
        [st ch] (pipe {:min x :max x})]
    (net
     (last st)
     (map (fn [s x]
            (cond
              (< x (:min s)) (emit ch (assoc s :min x))
              (< s (:max x)) (emit ch (assoc s :max x))
              true    (emit)))
          st (rest xs)))))

;; This is worst case 2N. Can we get Knuth's 3N/2 without realising the whole
;; stream into memory? What about:

(defn minmax2 [xs]
  (let [x (first xs)
        [st ch] (pipe {:min x :max x})]
    (net
     (last st)
     (map (fn [s [x y]]
            (let [[minv maxv] (if (< x y) [x y] [y x])]
              (emit ch (-> (update :min min minv) (update :max max maxv)))))
          ;; We need a version of partition that fills the last pair if the
          ;; stream count is odd. In this case duplicating the last value would
          ;; be correct.
          st (partition 2 (rest xs))))))
;; This makes 3N/2 ~comparisons~, but it does a lot of other work that might
;; very well swamp the gains.

;; You can do a streaming sort, though it only works in very limited
;; circumstances (you have to know with certainty that nothing in the future
;; will be smaller than what you're emitting now). Still, fun idea.
(defn merge-sorted [xs ys]
  (if (empty? xs)
    (emit-all :return ys)
    (if (empty? ys)
      (emit-all :return xs)
      (let [x (first xs)
            y (first ys)]
        (if (< x y)
          (emit-recur x (rest xs) ys)
          (emit-recur y xs (rest ys)))))))

;; Those `empty?` checks on each iteration are ugly. There should be an event
;; when a stream finishes... and how would that work?

;; Assume we're using a sorted binary tree as a set
;; This doesn't make a lot of sense as a stream problem.
(defn set-insert [node val]
  (if (empty? node)
    {:type :leaf :value val}
    ;; Assume we've already checked and we know the value is not in the tree
    (set-insert (get node (if (< val (:value node)) :left :right)) val)))
;; That gives us one branch (which should be replaced by polymorphic dispatch)
;; and one data selection.
;; It's a little more obscure than necessary, but still pretty clear I think.

(defn insert-sorted [v x]

  )

(defn insertion-sort [xs]
  (let [[st ch] (pipe [])]
    (net
     (with-channels {:return ch}
       (map insert-sorted st xs))
     (last st))))


;; run `rf` only on leaves of the tree, ignoring interior nodes.
(defn reduce-leaves [rf init tree])
