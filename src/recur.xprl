;; Here we derive a version of the fixed point (Y) combinator for μs.
;;
;; In fact we derive many such operators including the classic Ys.

;; N.B.: This file goes through alternating phases of working and burning off eyebrows.

(def Y
  (μ f
     ~((μ x ~(f . ~(x . ~x)))
       .
       ~(μ x ~(f . ~(x . ~x))))))

(def !1
  (Y . ~(μ !
           ~(μ x
               ~(if (<* ~x 2)
                  1
                  (** ~x ~(! . ~(-* ~x 1))))))))

(!1 . 1)
(!1 . 2)
(!1 . 3)
(!1 . 4)
(!1 . 5)
(!1 . 6)

(!1 . 10)

(def AoY
  (μ f
     ~((μ g
          ~(μ x
              ~((f . ~(g . ~g)) . ~x)))
       .
       ~(μ g
           ~(μ x
               ~((f . ~(g . ~g)) . ~x))))))

(def !2
  (AoY . ~(μ !
             ~(μ x
                 ~(if (<* ~x 2)
                    1
                    (** ~x ~(! . ~(-* ~x 1))))))))

(!2 . 1)
(!2 . 2)
(!2 . 3)
(!2 . 4)
(!2 . 5)
(!2 . 6)

(!2 . 10)

;; And now without Y (or are we just deriving a Y analogue?)

(def !3
  (μ !
     ~(μ x
         ~(if (<* ~x 2)
            1
            (** ~x ~((~! . ~!) . ~(-* ~x 1)))))))

((!3 . !3) . 1)
((!3 . !3) . 2)
((!3 . !3) . 5)

;; curry with self as first arg. Weird thought, but Curry was original.
(def sc
  (μ f
     ~(μ x
         ~((~f . ~~f) . ~x))))

(def !4
  (sc . ~(μ !
            ~(μ x
                ~(if (<* ~x 2)
                   1
                   (** ~x ~((sc . !) . ~(-* ~x 1))))))))

(!4 . 1)
(!4 . 2)
(!4 . 3)

(!4 . 10)

(def !!
  (μ !
     ~(μ x
         ~(if (<* ~x 2)
            1
            (** ~x ~(! . ~(-* ~x 1)))))))


(def !5
  (sc . ~(μ f ~(!! . ~(sc . f)))))

(!5 . 1)

(!5 . 2)
(!5 . 3)

(!5 . 10)

(def rec
  (μ g
     ~(sc . ~(μ f
                ~(g . ~(sc . f))))))

(def !6
  (rec . ~(μ !
             ~(μ x
                 ~(if (<* ~x 2)
                    1
                    (** ~x ~(! . ~(-* ~x 1))))))))

(!6 . 1)

(!6 . 2)
(!6 . 3)

(!6 . 10)

;; Recursion without built in names!

;; REVIEW: I still may go back to unnamed μs and use this instead. But it would
;; have to make the language a lot better or simpler to be justified.
(def defrec
  (μ x
     ~(def ~(nth* ~x 1)
        (rec . ~(μ ~(nth* ~x 1)
                   ~(μ ~(nth* ~x 2)
                       ~~(nth* ~x 3)))))))

(defrec !8 x
  (if (<* ~x 2)
    1
    (** ~x ~(!8 . ~(-* ~x 1)))))

(!8 . 1)

(!8 . 2)
(!8 . 3)
(!8 . 4)
(!8 . 5)

(!8 . 10)
