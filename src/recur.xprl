;; Here we derive a version of the fixed point (Y) combinator for μs.
;;
;; In fact we derive many such operators including the classic Ys.

;; N.B.: This file goes through alternating phases of working and being a fork bomb.

(emit :env [def ~(μ x ~(emit :env [~(nth* ~x 1) ~~(nth* ~x 2)] :return ~(nth* ~x 1)))]
      :return def)

(def if
  (μ x
     ~~(nth* ~x ~(-* 3 ~(get* {false 0 true 1} ~~(nth* ~x 1))))))

(def !
  (μ ! x
     ~(if (<* ~x 2)
        1
        (** ~x ~(! . ~(-* ~x 1))))))

(! . 1)
(! . 2)
(! . 3)

(! . 10)

(def Y
  (μ f
     ~((μ x ~(f . ~(x . ~x)))
       .
       ~(μ x ~(f . ~(x . ~x))))))

(def !
  (Y . ~(μ !
           ~(μ x
               ~(if (<* ~x 2)
                  1
                  (** ~x ~(! . ~(-* ~x 1))))))))

(! . 1)
(! . 2)
(! . 3)

(! . 10)

(def AoY
  (μ f
     ~((μ g
          ~(μ x
              ~((f . ~(g . ~g)) . ~x)))
       .
       ~(μ g
           ~(μ x
               ~((f . ~(g . ~g)) . ~x))))))

(def !
  (AoY . ~(μ !
             ~(μ x
                 ~(if (<* ~x 2)
                    1
                    (** ~x ~(! . ~(-* ~x 1))))))))

(! . 1)
(! . 2)
(! . 3)

(! . 10)

;; And now without Y (or are we just deriving a Y analogue?)

(def !
  (μ !
     ~(μ x
         ~(if (<* ~x 2)
            1
            (** ~x ~((~! . ~!) . ~(-* ~x 1)))))))

((! . !) . 5)

;; curry with self as first arg. Weird thought, but Curry was original.
(def sc
  (μ f
     ~(μ x
         ~((~f . ~~f) . ~x))))

(def !
  (sc . ~(μ !
            ~(μ x
                ~(if (<* ~x 2)
                   1
                   (** ~x ~((sc . !) . ~(-* ~x 1))))))))

(! . 1)
(! . 2)
(! . 3)

(! . 10)

(def !!
  (μ !
     ~(μ x
         ~(if (<* ~x 2)
            1
            (** ~x ~(! . ~(-* ~x 1)))))))


(def !
  (sc . ~(μ f ~(!! . ~(sc . f)))))

(! . 1)

(! . 2)
(! . 3)

(! . 10)

(def rec
  (μ g
     ~(sc . ~(μ f
                ~(g . ~(sc . f))))))

(def !
  (rec . ~(μ !
             ~(μ x
                 ~(if (<* ~x 2)
                    1
                    (** ~x ~(! . ~(-* ~x 1))))))))

(! . 1)

(! . 2)
(! . 3)

(! . 10)


(def !body
  (μ x
     ~(if (<* ~x 2)
        1
        (** ~x ~(! . ~(-* ~x 1))))))

(def ! (rec . ~(μ ! ~!body)))

(! . 1)

(! . 2)
(! . 3)

(! . 10)

(def defrec
  (μ x
     ~(def ~(nth* ~x 1)
        (rec . ~(μ ~(nth* ~x 1) ~~(nth* ~x 2))))))

(defrec ! !body)

(! . 1)

(! . 2)
(! . 3)

(! . 10)
